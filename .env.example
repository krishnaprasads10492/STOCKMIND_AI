# ═══════════════════════════════════════════════════════════════════════════════
# StockMind AI v0.5.1 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore
# VITE_ prefix = client-side (exposed to browser). All others = server-side only.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4098
VITE_APP_ENV=development
VITE_APP_VERSION=0.5.1
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1: SECURITY & ENCRYPTION
# ─────────────────────────────────────────────────────────────────────────────

# Master password for AES-256-GCM file encryption.
# CRITICAL: changing this makes ALL existing encrypted data unreadable.
# Use a strong random password (32+ chars recommended).
DATA_PASSWORD=change-this-to-a-very-strong-random-password-before-first-run

# Key Derivation Function (KDF) parameters.
# Argon2id is used when the argon2 npm package is installed (recommended).
# Falls back to PBKDF2-SHA512 automatically.
# Higher values = stronger but slower startup.
KDF_MEMORY_COST=131072      # 128 MiB (Argon2id)
KDF_TIME_COST=4             # iterations (Argon2id)
KDF_PARALLELISM=4           # parallel threads (Argon2id)
KDF_PBKDF2_ITERATIONS=600000  # NIST 2024 minimum (PBKDF2 fallback)

# Encryption HMAC integrity layer (detects file tampering)
ENC_HMAC_ENABLED=true
ENC_AAD_ENABLED=true
ENC_KEY_VERSION=1

# Session security
SESSION_MAX_CONCURRENT=5    # max simultaneous sessions per user
SESSION_FINGERPRINT=true    # bind session to User-Agent
SESSION_BIND_IP=false       # false = allow IP changes (for mobile users)
SESSION_BIND_UA=true

# Brute-force protection
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MS=900000      # 15 minutes (ms)
AUTH_PROGRESSIVE_DELAY=true
AUTH_IP_MAX_ATTEMPTS=20
AUTH_IP_BLOCK_MS=3600000    # 1 hour (ms)

# IP controls (comma-separated CIDR/IP, leave blank = no restriction)
IP_ALLOWLIST=               # e.g. 192.168.1.0/24,10.0.0.1
IP_BLOCKLIST=               # e.g. 1.2.3.4,5.6.7.8
IP_ALLOW_LOCAL=true

# Request signing (Node.js → Python internal calls)
REQUEST_SIGNING_ENABLED=false
REQUEST_SIGNING_SECRET=     # random 64-char hex string

# HTTPS / HSTS (leave false for local dev)
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2: DATABASES
# ─────────────────────────────────────────────────────────────────────────────
# Multiple databases can be active simultaneously.
# LOCAL (encrypted files) is always available as fallback.
# Each data category can be independently routed to any active backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data routing ─────────────────────────────────────────────────────────────
# Options: local | sqlite | postgres | mongodb | redis
# If the configured backend is disabled, falls back to the next available.
DB_USERS=local              # User accounts and credentials
DB_PREDICTIONS=local        # Prediction records
DB_SESSIONS=local           # Active sessions (use redis for performance)
DB_ANALYTICS=local          # Analytics and accuracy data
DB_AUDIT=local              # Audit log (always append-only)
DB_CACHE=local              # Short-lived cache (use redis for performance)
DB_AMI=local                # Advanced Market Intelligence data
DB_STRATEGIES=local         # Stored strategies
DB_BACKTEST=local           # Backtest result cache

# ── SQLite (zero-config relational DB, no server needed) ─────────────────────
SQLITE_ENABLED=false
SQLITE_PATH=./data/stockmind.db
SQLITE_ENCRYPTION_KEY=      # SQLCipher key (optional, requires better-sqlite3-sqlcipher)
SQLITE_POOL_SIZE=5
SQLITE_BUSY_TIMEOUT_MS=5000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Enable for production multi-user deployments.
# Install driver: npm install pg
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockmind
POSTGRES_USER=stockmind
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_URL=               # Takes precedence: postgresql://user:pass@host:port/db
POSTGRES_SCHEMA=public
POSTGRES_SSL=false
POSTGRES_SSL_VERIFY=true
POSTGRES_SSL_CA=            # Path to CA cert file
POSTGRES_SSL_KEY=           # Path to client key file
POSTGRES_SSL_CERT=          # Path to client cert file
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_POOL_ACQUIRE_MS=30000
POSTGRES_POOL_IDLE_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Great for predictions and AMI data (flexible schema, fast queries).
# Install driver: npm install mongodb
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017/stockmind
MONGODB_DB=stockmind
MONGODB_ATLAS_URI=          # MongoDB Atlas URI takes precedence if set
MONGODB_POOL_MAX=10
MONGODB_POOL_MIN=2
MONGODB_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_TLS=false
MONGODB_TLS_CA=             # Path to CA cert
MONGODB_TLS_CERT=           # Path to client cert+key PEM
MONGODB_FIELD_ENCRYPT=false # Field-level encryption (requires MongoDB 6.0+)
MONGODB_ENCRYPTION_KEY=     # 96-byte base64 key for field-level encryption

# ── Redis ─────────────────────────────────────────────────────────────────────
# Best for sessions, rate limiting, and caching (sub-millisecond).
# Install driver: npm install ioredis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # Leave blank if no auth
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=                  # redis://[:password@]host:port/db (takes precedence)
REDIS_KEY_PREFIX=stockmind:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=200
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
# TTLs (seconds)
REDIS_SESSION_TTL=28800     # 8 hours
REDIS_CACHE_TTL=300         # 5 minutes
REDIS_RATELIMIT_TTL=900     # 15 minutes
REDIS_PREDICTION_TTL=86400  # 24 hours
# Redis Sentinel (HA)
REDIS_SENTINEL=false
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_NODES=       # sentinel1:26379,sentinel2:26379

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3: AUDIT LOGGING
# ─────────────────────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_HMAC_CHAIN=true       # Tamper-evident HMAC chain
AUDIT_RETENTION_DAYS=365
AUDIT_EXPORT_FORMAT=json
# Which events to log (high-volume events default off)
AUDIT_LOGIN=true
AUDIT_LOGIN_FAILED=true
AUDIT_LOGOUT=true
AUDIT_KEYGEN=true
AUDIT_USER_CREATE=true
AUDIT_USER_DEACT=true
AUDIT_PW_CHANGE=true
AUDIT_ADMIN=true
AUDIT_GHOST=true
AUDIT_SUSPICIOUS=true
AUDIT_DATA_ACCESS=false     # Very high volume — enable for compliance mode
AUDIT_PREDICTION=false      # Very high volume — enable for compliance mode

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4: AI / ML BACKENDS
# ─────────────────────────────────────────────────────────────────────────────

# Python AI backend
AI_BACKEND_URL=http://localhost:8001
VITE_AI_API_URL=http://localhost:4098/api/inference

# AI Growth Worker
AI_GROWTH_WORKER_ENABLED=false
AI_GROWTH_INTERVAL_MS=300000  # 5 minutes

# ── Cloud LLM providers (JARVIS AI) ──────────────────────────────────────────
JARVIS_AI_PROVIDER=auto     # auto | openai | anthropic | gemini | local

# OpenAI (GPT-4o, GPT-4o-mini) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Haiku) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google (Gemini 1.5 Pro/Flash) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (Llama 3, Mixtral — very fast) — https://console.groq.com/keys
GROQ_API_KEY=

# Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 5: MARKET DATA FEEDS
# ─────────────────────────────────────────────────────────────────────────────

VITE_LIVE_FEED=auto         # auto | zerodha | finnhub | mock

# Zerodha Kite Connect (real-time NSE/BSE)
VITE_ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret
ZERODHA_ACCESS_TOKEN=       # auto-filled after OAuth login
ZERODHA_REDIRECT_URL=http://localhost:4098/api/zerodha/callback

# Finnhub (free tier fallback) — https://finnhub.io
VITE_FINNHUB_KEY=
FINNHUB_KEY=                # Server-side version

# Binance WebSocket (crypto — always free)
VITE_BINANCE_WS_ENABLED=true

# Alpha Vantage (historical + intraday) — https://www.alphavantage.co
VITE_ALPHA_VANTAGE_KEY=
ALPHA_VANTAGE_KEY=

# Twelve Data — https://twelvedata.com
VITE_TWELVE_DATA_KEY=

# FRED (macroeconomic data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 6: RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATELIMIT_AUTH=10           # per 15 min
RATELIMIT_KEYGEN=5          # per hour
RATELIMIT_PREDICTION=30     # per minute
RATELIMIT_IMAGE=10          # per minute
RATELIMIT_API=300           # per minute
RATELIMIT_ADMIN=60          # per minute

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 7: FRONTEND FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
VITE_ENABLE_PREDICTIONS=true
VITE_ENABLE_SENTIMENT=false
VITE_ENABLE_CV_PATTERNS=false
VITE_ENABLE_RL_TIMING=false

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 8: COMPLIANCE & SAFETY
# ─────────────────────────────────────────────────────────────────────────────
VITE_DISCLAIMER_JURISDICTION=IN   # IN | US | EU
VITE_CONFIDENCE_FLOOR=5           # minimum probability shown (%)
VITE_CONFIDENCE_CEILING=99        # maximum probability shown (%)
VITE_MIN_HISTORY_MONTHS=6
VITE_HMAC_VERIFY_KEY=             # public key for prediction HMAC verification

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 9: THEME / WALLPAPER APIS (all free)
# ─────────────────────────────────────────────────────────────────────────────
# Unsplash — 50 req/hour free — https://unsplash.com/developers
UNSPLASH_API_KEY=

# Pexels — 200 req/hour free — https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — 100 req/min free — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 10: DATA RETENTION
# ─────────────────────────────────────────────────────────────────────────────
CLEANUP_RETENTION_DAYS=30   # predictions older than this are archived

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 11: ANOMALY DETECTION
# ─────────────────────────────────────────────────────────────────────────────
ANOMALY_OFF_HOURS=false     # alert on access outside business hours
BIZ_HOURS_START=6           # 6 AM
BIZ_HOURS_END=23            # 11 PM
