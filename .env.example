# ─────────────────────────────────────────────────────────────────────────────
# StockMind AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# All client-side vars MUST be prefixed with VITE_
# NEVER commit .env.local — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Live feed provider selection ─────────────────────────────────────────────
# Controls which live data source is used for Indian markets.
# Options:
#   auto      — 0xramm API first (free, no key), then Finnhub, then mock (DEFAULT)
#   zerodha   — Zerodha Kite Connect WebSocket (real-time, requires subscription)
#   mock      — Simulated data only (offline use)
#
# 0xramm API (http://65.0.104.9/) is FREE, no key needed, covers NSE+BSE.
# Crypto always uses Binance WebSocket regardless of this setting.
VITE_LIVE_FEED=auto

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Required when VITE_LIVE_FEED=zerodha
#
# Step 1: Create a Kite Connect app at https://developers.kite.trade
#         (requires ₹2000/month developer subscription)
# Step 2: Set your api_key and api_secret below (server-side only — no VITE_ prefix)
# Step 3: Run the login flow: open http://localhost:5000/api/zerodha/login
#         This redirects to Kite login page. After login, the access_token
#         is automatically saved and used for the WebSocket feed.
# Step 4: Access token expires daily at 6:00 AM IST — re-login each trading day.
#
# SECURITY: api_secret and access_token are SERVER-SIDE ONLY.
# They are never sent to the browser. Only VITE_ZERODHA_API_KEY is client-side
# (it's public — used to construct the login URL).
#
VITE_ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret
ZERODHA_ACCESS_TOKEN=                    # auto-filled after login flow
ZERODHA_REDIRECT_URL=http://localhost:5000/api/zerodha/callback

# ── Finnhub (free tier fallback) ──────────────────────────────────────────────
# Used when VITE_LIVE_FEED=finnhub
# Free tier: 60 requests/minute. Get key at https://finnhub.io
VITE_FINNHUB_KEY=your_finnhub_key

# ── Binance WebSocket (Crypto — always free, no key needed) ──────────────────
# Automatically used for crypto module regardless of VITE_LIVE_FEED setting.
# No configuration needed. Set to false to disable and use mock instead.
VITE_BINANCE_WS_ENABLED=true

# ── Tier 0 — Long history / EOD ──────────────────────────────────────────────
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key
VITE_TWELVE_DATA_KEY=your_twelve_data_key

# ── AI / ML Inference backend ────────────────────────────────────────────────
VITE_AI_API_URL=http://localhost:5000/api/inference

# ── App config ───────────────────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_VERSION=0.2.0

# ── Feature flags ────────────────────────────────────────────────────────────
VITE_ENABLE_PREDICTIONS=true
VITE_ENABLE_SENTIMENT=false
VITE_ENABLE_CV_PATTERNS=false
VITE_ENABLE_RL_TIMING=false

# ── Safety / compliance ───────────────────────────────────────────────────────
VITE_DISCLAIMER_JURISDICTION=IN
VITE_CONFIDENCE_FLOOR=5
VITE_CONFIDENCE_CEILING=99
VITE_MIN_HISTORY_MONTHS=6

# ── Backend / data ────────────────────────────────────────────────────────────
# Encryption password for local data files (AES-256-GCM)
# MUST be the same on every run — changing it makes existing data unreadable
DATA_PASSWORD=stockmind-local-dev-password

# Backend port
PORT=5000

# Python AI backend URL
AI_BACKEND_URL=http://localhost:8001

# Prediction data retention (days) — older predictions are cleaned up automatically
CLEANUP_RETENTION_DAYS=30

# Finnhub API key (server-side — used by outcome validator as price fallback)
FINNHUB_KEY=

# ── JARVIS AI Brain — Cloud LLM providers ────────────────────────────────────
# Set ONE or more of these to unlock full JARVIS AI capabilities.
# Without a key, JARVIS runs in local mode (rule-based, no code generation).
#
# Provider selection: auto | openai | anthropic | gemini | local
# 'auto' tries OpenAI first, then Anthropic, then Gemini, then local.
JARVIS_AI_PROVIDER=auto

# OpenAI — GPT-4o-mini (fast, cheap, excellent for code)
# Get key: https://platform.openai.com/api-keys
# Cost: ~$0.15/1M input tokens, ~$0.60/1M output tokens
OPENAI_API_KEY=

# Anthropic — Claude 3 Haiku (fast, great reasoning)
# Get key: https://console.anthropic.com/
# Cost: ~$0.25/1M input tokens, ~$1.25/1M output tokens
ANTHROPIC_API_KEY=

# Google — Gemini 1.5 Flash (free tier available)
# Get key: https://aistudio.google.com/app/apikey
# Cost: Free tier available, then $0.075/1M tokens
GEMINI_API_KEY=

# FRED API key — for macroeconomic data (GDP, inflation, interest rates)
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage — for intraday + daily historical data
# Free tier: 25 requests/day. Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# ── Theme Wallpaper APIs ──────────────────────────────────────────────────────
# All are FREE. Without keys, JARVIS uses a curated collection of images.
# Add any one key to get live wallpaper search for theme generation.
#
# Unsplash — best quality, 50 req/hour free
# Get key: https://unsplash.com/developers (create a free app)
UNSPLASH_API_KEY=

# Pexels — excellent quality, 200 req/hour free
# Get key: https://www.pexels.com/api/ (instant approval)
PEXELS_API_KEY=

# Pixabay — good quality, 100 req/min free
# Get key: https://pixabay.com/api/docs/ (instant approval)
PIXABAY_API_KEY=
